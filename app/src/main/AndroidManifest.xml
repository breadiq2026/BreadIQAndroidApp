<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required as of this step (PORTING_PLAN.md step 2) — Supabase Auth
         calls are the app's first real network traffic; nothing needed it
         before this. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Bake notifications (PORTING_PLAN.md step 7). POST_NOTIFICATIONS
         is the API 33+ runtime permission gating any notification post
         at all — requested once from MainActivity, see its own doc
         comment. SCHEDULE_EXACT_ALARM (not USE_EXACT_ALARM — see
         BakeNotificationScheduler's own doc comment on why) gates
         AlarmManager.setExactAndAllowWhileIdle on API 31+; on API 33+ its
         grant has no in-app dialog, only a Settings deep link, also
         requested once from MainActivity. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Calendar integration (PORTING_PLAN.md step 7). Both are runtime
         (dangerous) permissions on all supported API levels — requested
         lazily, right when the user taps "Add to Calendar" on the
         Schedule screen, see ScheduleScreen.kt's own doc comment. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <application
        android:name=".BreadIQApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.BreadIQ"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BreadIQ">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives the AlarmManager alarms BakeNotificationScheduler
             schedules and posts the actual notification at fire time —
             see its own doc comment. Not exported: only this app's own
             explicit-Intent PendingIntents ever target it. -->
        <receiver
            android:name=".core.BakeNotificationReceiver"
            android:exported="false" />
    </application>

</manifest>
