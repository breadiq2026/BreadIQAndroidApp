<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required as of this step (PORTING_PLAN.md step 2) — Supabase Auth
         calls are the app's first real network traffic; nothing needed it
         before this. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Bake notifications (PORTING_PLAN.md step 7). POST_NOTIFICATIONS
         is the API 33+ runtime permission gating any notification post
         at all — requested once from MainActivity, see its own doc
         comment. SCHEDULE_EXACT_ALARM (not USE_EXACT_ALARM — see
         BakeNotificationScheduler's own doc comment on why) gates
         AlarmManager.setExactAndAllowWhileIdle on API 31+; on API 33+ its
         grant has no in-app dialog, only a Settings deep link, also
         requested once from MainActivity. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Calendar integration (PORTING_PLAN.md step 7). Both are runtime
         (dangerous) permissions on all supported API levels — requested
         lazily, right when the user taps "Add to Calendar" on the
         Schedule screen, see ScheduleScreen.kt's own doc comment. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Camera scan/import (PORTING_PLAN.md step 7, Session A). Requested
         lazily by ui/components/RecipeScanCapture.kt's CameraCaptureScreen
         the moment it's shown, matching the calendar permissions' lazy
         pattern above. No photo-library/media-storage permission is
         declared anywhere — the Photo Picker path needs none, see that
         file's own doc comment. `required="false"` on the feature
         declaration matches the source's own `isSourceTypeAvailable(.camera)`
         graceful-degradation check — a camera-less device can still
         install and use the app, just not the camera scan path. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".BreadIQApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.BreadIQ"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BreadIQ">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Custom-scheme deep links — the Android counterpart of
                 Info.plist's CFBundleURLSchemes: ["breadiq-mobile"].
                 breadiq-mobile://import?token=... and
                 breadiq-mobile://reset-password#access_token=...&type=recovery
                 both arrive here; core/DeepLinkRouting.kt is the single
                 source of truth for what host/path means, not separate
                 manifest entries per destination, matching AppRouter's
                 own code-level routing on iOS. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="breadiq-mobile" />
            </intent-filter>

            <!-- App Links (Android's Universal Links) — the counterpart of
                 BreadIQ.entitlements' com.apple.developer.associated-domains
                 (applinks:breadiq.io, applinks:www.breadiq.io). Only
                 reset-password is wired, matching iOS's own choice (the
                 import flow has no web-link counterpart either).
                 autoVerify="true" alone does NOT make https://breadiq.io/
                 reset-password links open this app — see MainActivity.kt's
                 own doc comment on the still-outside-this-repo
                 assetlinks.json dependency. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="breadiq.io"
                    android:pathPrefix="/reset-password" />
                <data
                    android:scheme="https"
                    android:host="www.breadiq.io"
                    android:pathPrefix="/reset-password" />
            </intent-filter>
        </activity>

        <!-- Receives the AlarmManager alarms BakeNotificationScheduler
             schedules and posts the actual notification at fire time —
             see its own doc comment. Not exported: only this app's own
             explicit-Intent PendingIntents ever target it. -->
        <receiver
            android:name=".core.BakeNotificationReceiver"
            android:exported="false" />

        <!-- XLSX recipe export (PORTING_PLAN.md step 7, "Share Recipe").
             CalculatorViewModel.shareRecipe() writes the exported .xlsx to
             Context.cacheDir, then needs a content:// Uri to hand to an
             ACTION_SEND chooser — a plain file:// Uri would violate
             FileUriExposedException on API 24+. See res/xml/file_paths.xml
             for the exposed path (cache dir only). Not exported: only this
             app's own FileProvider.getUriForFile(...) calls create Uris for
             it; grantUriPermissions lets the receiving share-target app
             read that one Uri temporarily without any broader access. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
